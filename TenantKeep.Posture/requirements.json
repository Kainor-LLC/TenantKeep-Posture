{
  "version": "2026.11.0",
  "about": "What each collection step needs, least privilege first: the Entra or service role that grants the read, the delegated Graph scopes on the TenantKeep Posture app, and the licence when the API answers only for licensed tenants. Errors name these so a failed run says what to grant. A role list is any-of. Entries marked verify are not yet confirmed by the least-privilege live run (plan Phase 3).",
  "collectors": {
    "Entra": { "service": "Microsoft Graph", "roles": ["Global Reader"], "note": "Global Reader reads every Entra setting the collector uses." },
    "Intune": { "service": "Microsoft Graph (Intune)", "roles": ["Global Reader", "Intune Administrator"], "licence": "Intune", "note": "Global Reader reads Intune configuration (verify); an Intune Read Only Operator role assignment also works." },
    "Defender": { "service": "Microsoft Graph (Defender XDR)", "roles": ["Security Reader", "Global Reader"], "note": "Defender for Endpoint data also needs read access to the device groups in Defender unified RBAC when it is turned on (verify)." },
    "Exchange": { "service": "Exchange Online PowerShell", "roles": ["Global Reader", "View-Only Organization Management (Exchange role group)"], "note": "Never Exchange Administrator: the collector only reads." },
    "Purview": { "service": "Security & Compliance PowerShell", "roles": ["TenantKeep Posture (view only) role group", "Compliance Administrator"], "note": "deploy/setup/New-PosturePurviewApp.ps1 creates the view-only role group; Global Reader alone does not see every Purview setting (verify)." },
    "SharePoint": { "service": "SharePoint admin (PnP.PowerShell)", "roles": ["SharePoint Administrator"], "note": "The tenant settings read is refused to Global Reader (verify in Phase 3)." },
    "Teams": { "service": "Teams PowerShell", "roles": ["Global Reader", "Teams Administrator"], "note": "Global Reader reads the Teams tenant configuration (verify)." },
    "Azure": { "service": "Azure Resource Manager", "roles": ["Reader (on each subscription)", "Security Reader (on each subscription, for Defender for Cloud)"], "note": "Azure roles, granted on the subscriptions or a management group, not in Entra." }
  },
  "steps": [
    { "collector": "Entra", "match": "^(Risky users|Risk detections)$", "roles": ["Security Reader", "Global Reader"], "scopes": ["IdentityRiskyUser.Read.All", "IdentityRiskEvent.Read.All"], "licence": "Microsoft Entra ID P2" },
    { "collector": "Entra", "match": "^(PIM role policies|PIM for Groups)$", "roles": ["Global Reader", "Privileged Role Administrator"], "scopes": ["RoleManagementPolicy.Read.Directory", "PrivilegedAccess.Read.AzureADGroup"], "licence": "Microsoft Entra ID P2" },
    { "collector": "Entra", "match": "^Role assignments$", "roles": ["Global Reader"], "scopes": ["RoleManagement.Read.Directory", "RoleEligibilitySchedule.Read.Directory"] },
    { "collector": "Entra", "match": "^Auth method registration$", "roles": ["Reports Reader", "Global Reader"], "scopes": ["AuditLog.Read.All", "UserAuthenticationMethod.Read.All"], "licence": "Microsoft Entra ID P1 (verify)" },
    { "collector": "Entra", "match": "^Users$", "roles": ["Global Reader", "Reports Reader"], "scopes": ["User.Read.All", "AuditLog.Read.All"], "licence": "Microsoft Entra ID P1 for the last sign-in dates" },
    { "collector": "Entra", "match": "^Per-user MFA state$", "roles": ["Global Reader", "Authentication Policy Administrator"], "scopes": ["Policy.Read.All"], "note": "verify" },
    { "collector": "Entra", "match": "^(Access review definitions)$", "roles": ["Global Reader", "Identity Governance Administrator"], "scopes": ["AccessReview.Read.All"], "licence": "Microsoft Entra ID P2 or ID Governance" },
    { "collector": "Entra", "match": "^Access packages$", "roles": ["Global Reader", "Identity Governance Administrator"], "scopes": ["EntitlementManagement.Read.All"], "licence": "Microsoft Entra ID P2 or ID Governance" },
    { "collector": "Entra", "match": "^Lifecycle workflows$", "roles": ["Global Reader", "Lifecycle Workflows Administrator"], "scopes": ["LifecycleWorkflows.Read.All"], "licence": "Microsoft Entra ID Governance" },
    { "collector": "Entra", "match": "^Administrative units$", "roles": ["Global Reader"], "scopes": ["AdministrativeUnit.Read.All"] },
    { "collector": "Entra", "match": "^(App registrations|Service principals|Graph application permissions|Delegated OAuth2 grants)$", "roles": ["Global Reader", "Application Administrator"], "scopes": ["Application.Read.All", "Directory.Read.All"] },
    { "collector": "Intune", "match": "^BitLocker recovery keys$", "roles": ["Global Reader", "Security Reader", "Cloud Device Administrator"], "scopes": ["BitlockerKey.ReadBasic.All"], "note": "Reads key ids only, never the keys (verify the role list)." },
    { "collector": "Intune", "match": "^MDE connector$", "roles": ["Global Reader", "Intune Administrator"], "scopes": ["DeviceManagementServiceConfig.Read.All"], "licence": "Defender for Endpoint" },
    { "collector": "Intune", "match": "^(Apple push certificate|Apple VPP tokens|Enrollment restrictions|Autopilot devices|Device cleanup rules)$", "roles": ["Global Reader", "Intune Administrator"], "scopes": ["DeviceManagementServiceConfig.Read.All", "DeviceManagementConfiguration.Read.All"], "licence": "Intune" },
    { "collector": "Defender", "match": "^(Defender devices|Defender antivirus state|Defender secure configuration assessment|Defender vulnerabilities)$", "roles": ["Security Reader", "Global Reader"], "scopes": ["ThreatHunting.Read.All"], "licence": "Defender for Endpoint P2 or Defender for Business (advanced hunting)" },
    { "collector": "Defender", "match": "^Defender incidents$", "roles": ["Security Reader", "Global Reader"], "scopes": ["SecurityIncident.Read.All"] },
    { "collector": "Defender", "match": "^Secure Score$", "roles": ["Security Reader", "Global Reader"], "scopes": ["SecurityEvents.Read.All"] },
    { "collector": "Exchange", "match": "^Attack simulations$", "roles": ["Security Reader", "Attack Simulation Administrator"], "scopes": ["AttackSimulation.Read.All"], "licence": "Defender for Office 365 Plan 2" },
    { "collector": "Exchange", "match": "^Mail DNS$", "roles": [], "note": "Public DNS lookups for SPF, DMARC and MTA-STS; a failure is the network, not a role." },
    { "collector": "Purview", "match": "^(Sensitivity labels|Label policies|Auto-labeling policies)$", "roles": ["Information Protection Reader", "Compliance Administrator"], "licence": "Microsoft 365 E3, E5, Business Premium or Purview Information Protection" },
    { "collector": "Purview", "match": "^DLP (policies|rules)$", "roles": ["View-Only DLP Compliance Management (role)", "Compliance Administrator"] },
    { "collector": "Purview", "match": "^Retention (policies|rules|labels)$", "roles": ["View-Only Retention Management (role)", "View-Only Record Management (role)", "Compliance Administrator"] },
    { "collector": "Purview", "match": "^Insider Risk policies$", "roles": ["Insider Risk Management Auditors (role group)", "Insider Risk Management Admins"], "licence": "Microsoft 365 E5 or E5 Compliance (verify)" },
    { "collector": "Purview", "match": "^Communication Compliance$", "roles": ["Communication Compliance Analysts (role group)", "Communication Compliance Admins"], "licence": "Microsoft 365 E5 or E5 Compliance (verify)" },
    { "collector": "Purview", "match": "^Information barriers$", "roles": ["View-Only Information Barrier (verify)", "Compliance Administrator"] },
    { "collector": "Purview", "match": "^Audit retention policies$", "roles": ["View-Only Audit Logs (role)", "Compliance Administrator"], "licence": "Audit (Premium): Microsoft 365 E5 or E5 Compliance" },
    { "collector": "Purview", "match": "^eDiscovery cases$", "roles": ["eDiscovery Manager (role group)"], "note": "Listing cases needs eDiscovery Manager membership (verify); leave it out if that is more access than you want to give." },
    { "collector": "Purview", "match": "^Alert policies$", "roles": ["View-Only Manage Alerts (role)", "Security Reader"] },
    { "collector": "Purview", "match": "^Purview role groups$", "roles": ["View-Only Organization Management (role)", "Compliance Administrator"] },
    { "collector": "SharePoint", "match": "^Restricted SharePoint Search$", "roles": ["SharePoint Administrator"], "licence": "Microsoft 365 Copilot (the setting exists only for Copilot tenants, verify)" },
    { "collector": "Azure", "match": "^(Entra Connect Health)$", "roles": ["Global Reader"], "licence": "Microsoft Entra ID P1" },
    { "collector": "Azure", "match": "^(Entra diagnostic settings)$", "roles": ["Global Reader", "Security Reader"], "note": "verify" },
    { "collector": "Azure", "match": "^(Defender for Cloud plans|Defender for Cloud security contacts|Azure Secure Score and assessments)$", "roles": ["Security Reader (on each subscription)", "Reader (on each subscription)"] }
  ]
}
