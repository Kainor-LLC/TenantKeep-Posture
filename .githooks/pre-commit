# Pre-commit secret scanner. Enable once per clone: git config core.hooksPath .githooks
set -e
ROOT="$(git rev-parse --show-toplevel)"
if ! command -v pwsh >/dev/null 2>&1; then
  echo "pre-commit: pwsh not found; refusing to commit without the secret scan." >&2
  exit 1
fi
exec pwsh -NoProfile -NonInteractive -File "$ROOT/.githooks/Test-StagedSecrets.ps1"
